# ---------------------------------------------------------------------------
# Modele de configuration. NE METTEZ JAMAIS de vrais secrets dans ce fichier :
# il est versionne et le depot est public.
#
#   ./scripts/init-env.sh      -> cree .env avec des secrets aleatoires (recommande)
#
# ou a la main : cp .env.example .env puis remplacez chaque CHANGE_MOI, par exemple avec
#   openssl rand -base64 48
# Avec APP_STRICT_SECRETS=true (defaut en Docker), le backend REFUSE de demarrer tant qu'une
# valeur CHANGE_MOI (ou admin123) subsiste.
# ---------------------------------------------------------------------------

POSTGRES_USER=assoue
POSTGRES_PASSWORD=CHANGE_MOI

# Signature des JWT (HMAC-SHA256) : 32 caracteres minimum.
JWT_SECRET=CHANGE_MOI

# Chiffrement au repos du nom et du telephone (AES-256-GCM, exigence CIL) + hachage du telephone.
# La perdre rend les donnees illisibles ; la changer invalide tous les comptes existants.
# Sauvegardez-la a part (gestionnaire de mots de passe / coffre).
DATA_ENCRYPTION_KEY=CHANGE_MOI

# Signature HMAC du webhook Orange Money / Moov Money. A remplacer par la cle fournie par chaque
# operateur lors de l'integration reelle.
PAYMENT_WEBHOOK_SECRET=CHANGE_MOI

# Mot de passe du compte admin (admin@cif.bf) cree au premier demarrage. 12 caracteres minimum.
# Changez-le aussi dans "Mon compte" apres la premiere connexion.
ADMIN_DEFAULT_PASSWORD=CHANGE_MOI

# true  : refuse de demarrer avec un secret d'exemple (defaut dans docker-compose.yml).
# false : avertissement seulement -- dev local sans Docker.
APP_STRICT_SECRETS=true

# Ne jamais mettre a true en production : expose la console H2 (sans effet avec Postgres).
H2_CONSOLE_ENABLED=false

# Mettre a false en production : masque Swagger UI et /api-docs.
SWAGGER_ENABLED=true

# Origines autorisees a appeler l'API directement depuis un navigateur (CORS), separees par des virgules.
# Inutile via Nginx (meme origine) ; sert a "ng serve" (4200) et aux appels directs sur 8080.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Geocodage OpenStreetMap (Nominatim) ---
# Instance publique gratuite par defaut, limitee a 1 requete/seconde.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OBLIGATOIRE par leur politique d'usage : un User-Agent identifiant l'app, avec un contact valide
# (https://operations.osmfoundation.org/policies/nominatim/). Remplacez l'adresse ci-dessous.
GEOCODING_USER_AGENT=AssoueStore/1.0 (contact@assoue.bf)
