# Copier ce fichier en .env avant de lancer docker compose (le .env n'est jamais commite).
# cp .env.example .env

POSTGRES_USER=assoue
POSTGRES_PASSWORD=postgres

# Minimum 32 caracteres (utilise pour signer les JWT en HMAC-SHA256).
JWT_SECRET=CHANGE_MOI_secret_partage_assoue_store_2026_min_32_car

# Cle de chiffrement des donnees personnelles au repos (nom, telephone -- exigence CIL Burkina Faso).
# La perdre rend les donnees illisibles ; la changer invalide tous les comptes existants.
DATA_ENCRYPTION_KEY=CHANGE_MOI_cle_chiffrement_donnees_perso_2026

# Cle de signature HMAC du webhook operateur (Orange Money / Moov Money).
# A remplacer par la cle reelle fournie par chaque operateur lors de l'integration.
PAYMENT_WEBHOOK_SECRET=CHANGE_MOI_secret_webhook_orange_moov_2026

# Ne jamais mettre a true en production : expose la console H2 (utile en dev seulement,
# et de toute facon sans effet des que SPRING_DATASOURCE_URL pointe vers Postgres).
H2_CONSOLE_ENABLED=false

# Origines autorisees a appeler l'API depuis un navigateur (CORS), separees par des virgules.
# En local avec "ng serve" (frontend Angular), 4200 est le port par defaut.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Geocodage OpenStreetMap (Nominatim) ---
# Instance publique gratuite par defaut (aucune cle requise), limitee a 1 requete/seconde.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OBLIGATOIRE par leur politique d'usage : un User-Agent identifiant reellement l'app,
# avec un contact valide (email ou URL) -- https://operations.osmfoundation.org/policies/nominatim/
GEOCODING_USER_AGENT=AssoueStore/1.0 (contact@assoue.bf)
